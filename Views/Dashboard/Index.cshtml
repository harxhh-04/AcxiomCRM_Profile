@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            Sales & CRM Overview
        </h2>
        <p class="text-muted small mb-0">
            Welcome, <strong>@Model.UserName</strong> &bull; Scoped as <span class="badge bg-primary">@Model.UserRole</span>
        </p>
    </div>

    <!-- Date Range Filter Buttons -->
    <div class="btn-group shadow-sm bg-white p-1 rounded-3 border" role="group" aria-label="Date Range Filters">
        <a asp-action="Index" asp-route-dateFilter="today" class="btn btn-sm @(Model.DateFilter == "today" ? "btn-primary" : "btn-light")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="week" class="btn btn-sm @(Model.DateFilter == "week" ? "btn-primary" : "btn-light")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="month" class="btn btn-sm @(Model.DateFilter == "month" ? "btn-primary" : "btn-light")">This Month</a>
        <a asp-action="Index" asp-route-dateFilter="all" class="btn btn-sm @(Model.DateFilter == "all" ? "btn-primary" : "btn-light")">All Time</a>
    </div>
</div>

<!-- KPI Metrics Grid -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-6 col-md-3">
        <div class="card metric-card h-100 border-0 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Total Customers</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalCustomers</h3>
                </div>
                <div class="metric-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                <a asp-controller="Customers" asp-action="Index" class="text-decoration-none text-primary">View Customers &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-6 col-md-3">
        <div class="card metric-card h-100 border-0 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Total Leads</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalLeads</h3>
                </div>
                <div class="metric-icon-box bg-info-subtle text-info">
                    <i class="bi bi-funnel-fill"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                <span class="text-dark fw-semibold">@Model.OpenLeads</span> active / unqualified
            </div>
        </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-6 col-md-3">
        <div class="card metric-card h-100 border-0 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Opportunities</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalOpportunities</h3>
                </div>
                <div class="metric-icon-box bg-warning-subtle text-warning">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                <span class="text-success fw-semibold">@Model.WonOpportunities Won</span> &bull; <span class="text-danger">@Model.LostOpportunities Lost</span>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-6 col-md-3">
        <div class="card metric-card h-100 border-0 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Pipeline Value</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">$@Model.TotalPipelineValue.ToString("N0")</h3>
                </div>
                <div class="metric-icon-box bg-success-subtle text-success">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">
                <span class="text-dark fw-semibold">@Model.OpenOpportunities</span> active in pipeline
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPIs -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card p-3 border-0 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon-box bg-info-subtle text-info">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Open Leads</div>
                    <div class="fs-4 fw-bold text-dark">@Model.OpenLeads</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card p-3 border-0 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon-box bg-success-subtle text-success">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Won Opportunities</div>
                    <div class="fs-4 fw-bold text-success">@Model.WonOpportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card p-3 border-0 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="metric-icon-box bg-danger-subtle text-danger">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Lost Opportunities</div>
                    <div class="fs-4 fw-bold text-danger">@Model.LostOpportunities</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Opportunity Pipeline Stages -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill me-2 text-primary"></i> Opportunity Pipeline by Stage</h5>
                <span class="badge bg-light text-muted border">Stage Amount ($)</span>
            </div>
            <div class="card-body">
                <div style="height: 280px;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Lead Status Breakdown -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill me-2 text-info"></i> Lead Status Breakdown</h5>
                <span class="badge bg-light text-muted border">Distribution</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="height: 260px; width: 100%;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart 3: Monthly Sales Trend -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow me-2 text-success"></i> Monthly Sales & Outcome Performance</h5>
                <span class="badge bg-light text-muted border">Last 6 Months</span>
            </div>
            <div class="card-body">
                <div style="height: 240px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Activity & Upcoming Follow-Ups Grid -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-check-fill me-2 text-warning"></i> Upcoming Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill">+ Schedule</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingFollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var f in Model.UpcomingFollowUps)
                        {
                            <div class="list-group-item p-3 border-0 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold text-dark">@f.Subject</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-clock me-1"></i> @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm") &bull;
                                        <span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span>
                                    </div>
                                </div>
                                <div>
                                    <form asp-controller="FollowUps" asp-action="Complete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@f.FollowUpId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill" title="Mark Completed">
                                            <i class="bi bi-check2"></i> Done
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted small">
                        <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                        No pending follow-ups scheduled for today.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Opportunities -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase-fill me-2 text-primary"></i> Active Opportunities</h5>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentOpportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Opportunity</th>
                                    <th>Stage</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.RecentOpportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none text-dark">
                                                @o.OpportunityName
                                            </a>
                                            <div class="text-muted small">@o.Customer?.CustomerName</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@o.Stage</span>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            $@o.Amount.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted small">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        No opportunities created yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Pipeline Stage Bar Chart
            const pipelineCtx = document.getElementById('pipelineStageChart').getContext('2d');
            new Chart(pipelineCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                    datasets: [{
                        label: 'Total Pipeline ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts)),
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.75)',
                            'rgba(245, 158, 11, 0.75)',
                            'rgba(139, 92, 246, 0.75)',
                            'rgba(16, 185, 129, 0.75)',
                            'rgba(239, 68, 68, 0.75)'
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (val) { return '$' + Number(val).toLocaleString(); }
                            }
                        }
                    }
                }
            });

            // Lead Status Doughnut Chart
            const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                        backgroundColor: [
                            '#3b82f6',
                            '#06b6d4',
                            '#10b981',
                            '#8b5cf6',
                            '#ef4444'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12 }
                        }
                    }
                }
            });

            // Monthly Sales Line Chart
            const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                    datasets: [{
                        label: 'Won Sales ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts)),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (val) { return '$' + Number(val).toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
