@model AcxiomCRM.ViewModels.ConvertLeadViewModel
@{
    ViewData["Title"] = "Convert Lead: " + Model.LeadName;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Convert Lead to Customer</h2>
                <p class="text-muted small mb-0">Qualify prospective lead into an active Customer and Opportunity</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Leads
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>
                        Converting <strong>@Model.LeadName</strong> will create a new Customer account using their contact details.
                    </div>
                </div>

                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-2">Customer Profile to be Created</h6>
                        <div class="row g-2 small">
                            <div class="col-sm-6"><strong>Contact Name:</strong> @Model.LeadName</div>
                            <div class="col-sm-6"><strong>Company:</strong> @(string.IsNullOrEmpty(Model.CompanyName) ? "—" : Model.CompanyName)</div>
                            <div class="col-sm-6"><strong>Email:</strong> @Model.Email</div>
                            <div class="col-sm-6"><strong>Phone:</strong> @Model.Phone</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch fs-5">
                            <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="createOppSwitch" onchange="toggleOppFields()">
                            <label class="form-check-label fs-6 fw-semibold text-dark" for="createOppSwitch">
                                Also create a sales deal/opportunity in the pipeline
                            </label>
                        </div>
                    </div>

                    <div id="oppFields" class="row g-3 p-3 bg-white rounded-3 border mb-4">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label">Deal / Opportunity Name</label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Acme Enterprise Subscription" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Amount" class="form-label">Deal Amount ($)</label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check2-all me-1"></i> Confirm & Convert Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleOppFields() {
            const isChecked = document.getElementById('createOppSwitch').checked;
            document.getElementById('oppFields').style.display = isChecked ? 'flex' : 'none';
        }
    </script>
}
