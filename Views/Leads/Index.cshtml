@model AcxiomCRM.ViewModels.LeadIndexViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Leads</h2>
        <p class="text-muted small mb-0">Capture, qualify, assign, and convert prospective client inquiries</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-funnel-fill"></i> Capture Lead
        </a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search lead, company, email, phone..." />
                </div>
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.StatusFilter == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-6 col-md-2 col-lg-3">
                <select name="assignedFilter" class="form-select">
                    <option value="">All Assignees</option>
                    @foreach (var user in Model.UsersList)
                    {
                        <option value="@user.Value" selected="@(Model.AssignedFilter == user.Value)">@user.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leads.Any())
                    {
                        foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@l.LeadName</div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.75rem;">@l.LeadCode</span>
                                        <span class="badge bg-light text-muted border">@l.Source</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@(string.IsNullOrEmpty(l.CompanyName) ? "—" : l.CompanyName)</span>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1 text-muted small"></i> @l.Email</div>
                                    <div class="text-muted small"><i class="bi bi-telephone me-1 text-muted small"></i> @l.Phone</div>
                                </td>
                                <td>
                                    @if (l.Status == "New")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">New</span>
                                    }
                                    else if (l.Status == "Qualified")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Qualified</span>
                                    }
                                    else if (l.Status == "Converted")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Converted</span>
                                    }
                                    else if (l.Status == "Lost")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lost</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">@l.Status</span>
                                    }
                                </td>
                                <td class="fw-semibold text-dark">
                                    $@l.ExpectedValue.ToString("N0")
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @(l.AssignedTo?.FullName ?? "Unassigned")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (l.Status != "Converted")
                                        {
                                            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-arrow-repeat"></i> Convert
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@l.LeadId" title="Delete Lead">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteModal-@l.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start border-0 shadow">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i> Confirm Lead Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete lead <strong>@l.LeadName</strong> (@l.LeadCode)?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@l.LeadId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary"></i>
                                No leads found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
