@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Add Opportunity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Add Sales Opportunity</h2>
                <p class="text-muted small mb-0">Record a new sales pipeline deal</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise License Expansion" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CustomerId" class="form-label">Customer Account <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="LeadId" class="form-label">Originating Lead (Optional)</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- None / Direct Deal --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Amount" class="form-label">Deal Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" id="oppAmount" placeholder="Must be > 0" oninput="updateWeighted()" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Probability" class="form-label">Win Probability (%) <span class="text-danger">*</span></label>
                            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" id="oppProb" placeholder="0 - 100" oninput="updateWeighted()" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Stage" class="form-label">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select" id="oppStage" onchange="stageChanged()">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center border">
                                <span class="text-muted small">Estimated Weighted Pipeline Value:</span>
                                <span class="fw-bold text-success fs-5" id="weightedValueDisplay">$0</span>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="AssignedToId" class="form-label">Deal Owner</label>
                            <select asp-for="AssignedToId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">Deal Notes & Background</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key decision makers, requirements, timeline..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateWeighted() {
            const amount = parseFloat(document.getElementById('oppAmount').value) || 0;
            const prob = parseFloat(document.getElementById('oppProb').value) || 0;
            const weighted = (amount * prob) / 100;
            document.getElementById('weightedValueDisplay').innerText = '$' + Math.round(weighted).toLocaleString();
        }

        function stageChanged() {
            const stage = document.getElementById('oppStage').value;
            if (stage === 'Won') {
                document.getElementById('oppProb').value = 100;
            } else if (stage === 'Lost') {
                document.getElementById('oppProb').value = 0;
            }
            updateWeighted();
        }

        document.addEventListener("DOMContentLoaded", updateWeighted);
    </script>
}
