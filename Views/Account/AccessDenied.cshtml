@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="mb-3 text-warning">
                <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark">Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have administrative or authorization permissions to view this resource. 
                Your current role access scope prevents modifications to this area.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
