@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Summary Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Leads Summary Report</h2>
        <p class="text-muted small mb-0">Overview of prospective inquiries, status distribution, and expected valuations</p>
    </div>
    <div>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th class="text-end">Expected Value</th>
                        <th>Assigned Representative</th>
                        <th>Captured Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="font-monospace text-muted small">@l.LeadCode</td>
                            <td class="fw-semibold text-dark">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "—")</td>
                            <td>
                                <div>@l.Email</div>
                                <div class="text-muted small">@l.Phone</div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                            <td>
                                <span class="badge @(l.Status == "Converted" ? "bg-success-subtle text-success" : (l.Status == "Qualified" ? "bg-info-subtle text-info" : (l.Status == "Lost" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")))">
                                    @l.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge @(l.Priority == "High" ? "bg-warning-subtle text-dark border border-warning" : "bg-light text-dark border")">
                                    @l.Priority
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-dark">$@l.ExpectedValue.ToString("N0")</td>
                            <td>@(l.AssignedTo?.FullName ?? "Unassigned")</td>
                            <td class="text-muted small">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
