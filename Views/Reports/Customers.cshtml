@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Customer Accounts Report</h2>
        <p class="text-muted small mb-0">Master customer directory, accounts status, and sales ownership</p>
    </div>
    <div>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City / State</th>
                        <th>Account Owner</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace text-muted small">@c.CustomerCode</td>
                            <td class="fw-semibold text-dark">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "—")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(c.City ?? "—"), @(c.State ?? "—")</td>
                            <td>@(c.AssignedTo?.FullName ?? "Unassigned")</td>
                            <td>
                                <span class="badge @(c.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                                    @c.Status
                                </span>
                            </td>
                            <td class="text-muted small">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
