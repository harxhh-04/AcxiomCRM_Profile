@model IEnumerable<AcxiomCRM.ViewModels.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">User Activity & Compliance Report</h2>
        <p class="text-muted small mb-0">Staff operational metrics, record creation velocity, and last authenticated activity</p>
    </div>
    <div>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Assigned Role</th>
                        <th class="text-center">Total Audit Actions</th>
                        <th class="text-center">Records Created</th>
                        <th class="text-center">Records Modified</th>
                        <th class="text-center">Follow-Ups Logged</th>
                        <th>Last Active (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@u.UserName</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@u.Role</span>
                            </td>
                            <td class="text-center fw-bold">@u.TotalActions</td>
                            <td class="text-center text-success fw-medium">@u.CreatedRecords</td>
                            <td class="text-center text-info fw-medium">@u.UpdatedRecords</td>
                            <td class="text-center text-warning fw-medium">@u.FollowUpsLogged</td>
                            <td class="text-muted small">
                                @(u.LastActive.HasValue ? u.LastActive.Value.ToString("yyyy-MM-dd HH:mm:ss") : "No recorded events")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
