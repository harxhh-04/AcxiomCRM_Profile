@{
    ViewData["Title"] = "Sales Pipeline Report";
    var stageReport = ViewBag.StageReport as List<AcxiomCRM.ViewModels.PipelineReportItem> ?? new List<AcxiomCRM.ViewModels.PipelineReportItem>();
    var ownerReport = ViewBag.OwnerReport as List<AcxiomCRM.ViewModels.OwnerPipelineReportItem> ?? new List<AcxiomCRM.ViewModels.OwnerPipelineReportItem>();
    decimal totalPipeline = ViewBag.TotalPipeline != null ? (decimal)ViewBag.TotalPipeline : 0m;
    decimal totalWeighted = ViewBag.TotalWeighted != null ? (decimal)ViewBag.TotalWeighted : 0m;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Sales Pipeline Report</h2>
        <p class="text-muted small mb-0">Stage distribution, owner performance, and probability-weighted valuation</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPipelineCsv" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <div class="card p-4 border-0 bg-primary text-white shadow-sm">
            <span class="small fw-semibold text-uppercase opacity-75">Total Active Pipeline</span>
            <h2 class="fw-bold mt-1 mb-0">$@totalPipeline.ToString("N0")</h2>
            <span class="small opacity-75 mt-2 d-block">Cumulative value of all active unclosed opportunities</span>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card p-4 border-0 bg-success text-white shadow-sm">
            <span class="small fw-semibold text-uppercase opacity-75">Weighted Pipeline Forecast</span>
            <h2 class="fw-bold mt-1 mb-0">$@totalWeighted.ToString("N0")</h2>
            <span class="small opacity-75 mt-2 d-block">Expected forecast computed using (Amount &times; Probability / 100)</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Stage-Wise Breakdown -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i> Stage-Wise Pipeline</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Stage</th>
                                <th class="text-center">Count</th>
                                <th class="text-end">Total Amount</th>
                                <th class="text-end">Weighted Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in stageReport)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark border">@s.Stage</span>
                                    </td>
                                    <td class="text-center">@s.Count</td>
                                    <td class="text-end fw-semibold text-dark">$@s.TotalAmount.ToString("N0")</td>
                                    <td class="text-end text-success">$@s.WeightedAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Owner-Wise Breakdown -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill me-2 text-success"></i> Owner-Wise Pipeline Contribution</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sales Representative</th>
                                <th class="text-center">Deals</th>
                                <th class="text-end">Pipeline Amount</th>
                                <th class="text-end">Weighted Forecast</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in ownerReport)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@o.OwnerName</td>
                                    <td class="text-center">@o.OpportunityCount</td>
                                    <td class="text-end fw-semibold text-dark">$@o.TotalAmount.ToString("N0")</td>
                                    <td class="text-end text-success">$@o.WeightedAmount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
