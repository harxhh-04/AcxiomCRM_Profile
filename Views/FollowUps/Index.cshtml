@model AcxiomCRM.ViewModels.FollowUpIndexViewModel
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Follow-Up Schedule</h2>
        <p class="text-muted small mb-0">Track upcoming calls, meetings, client demos and resolve overdue tasks</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-calendar-plus-fill"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Status Counters -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a asp-action="Index" asp-route-dateFilter="upcoming" class="text-decoration-none">
            <div class="card p-3 border-0 bg-primary-subtle text-primary shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-semibold text-uppercase">Upcoming Planned</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.UpcomingCount</h3>
                    </div>
                    <div class="metric-icon-box bg-primary text-white">
                        <i class="bi bi-calendar2-check"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Index" asp-route-dateFilter="overdue" class="text-decoration-none">
            <div class="card p-3 border-0 bg-danger-subtle text-danger shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-semibold text-uppercase">Overdue / Action Needed</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.OverdueCount</h3>
                    </div>
                    <div class="metric-icon-box bg-danger text-white">
                        <i class="bi bi-alarm-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Index" asp-route-statusFilter="Completed" class="text-decoration-none">
            <div class="card p-3 border-0 bg-success-subtle text-success shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small fw-semibold text-uppercase">Completed Activities</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.CompletedCount</h3>
                    </div>
                    <div class="metric-icon-box bg-success text-white">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-4">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="typeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Demo" selected="@(Model.TypeFilter == "Demo")">Demo</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="dateFilter" class="form-select">
                    <option value="">All Dates</option>
                    <option value="upcoming" selected="@(Model.DateFilter == "upcoming")">Upcoming</option>
                    <option value="overdue" selected="@(Model.DateFilter == "overdue")">Overdue</option>
                    <option value="today" selected="@(Model.DateFilter == "today")">Due Today</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups List -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Subject & Type</th>
                        <th>Target Relation</th>
                        <th>Due Date & Time</th>
                        <th>Status</th>
                        <th>Assigned User</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUps.Any())
                    {
                        foreach (var f in Model.FollowUps)
                        {
                            <tr class="@(f.IsOverdue ? "table-danger bg-opacity-25" : "")">
                                <td>
                                    <div class="fw-semibold text-dark">@f.Subject</div>
                                    <div class="d-flex align-items-center gap-1 text-muted small">
                                        <span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span>
                                        <span class="text-truncate" style="max-width: 280px;">@f.Remarks</span>
                                    </div>
                                </td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <div><span class="text-muted small">Customer:</span> <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-medium text-decoration-none">@f.Customer.CustomerName</a></div>
                                    }
                                    @if (f.Lead != null)
                                    {
                                        <div><span class="text-muted small">Lead:</span> <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="fw-medium text-decoration-none">@f.Lead.LeadName</a></div>
                                    }
                                    @if (f.Opportunity != null)
                                    {
                                        <div><span class="text-muted small">Deal:</span> <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId" class="fw-medium text-decoration-none">@f.Opportunity.OpportunityName</a></div>
                                    }
                                    @if (f.Customer == null && f.Lead == null && f.Opportunity == null)
                                    {
                                        <span class="text-muted small">General Task</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium @(f.IsOverdue ? "text-danger" : "text-dark")">
                                        @f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                    @if (f.IsOverdue)
                                    {
                                        <span class="badge bg-danger">OVERDUE</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(f.Status == "Completed" ? "bg-success-subtle text-success" : (f.Status == "Planned" ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary"))">
                                        @f.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(f.AssignedTo?.FullName ?? "Unassigned")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (f.Status == "Planned")
                                        {
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Complete Follow-up">
                                                <i class="bi bi-check2"></i> Complete
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@f.FollowUpId" title="Delete Follow-up">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Complete Modal -->
                                    <div class="modal fade" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start border-0 shadow">
                                                <form asp-action="Complete" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@f.FollowUpId" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title text-success"><i class="bi bi-check-circle me-2"></i> Complete Follow-Up</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-3">Mark <strong>@f.Subject</strong> as completed.</p>
                                                        <label class="form-label">Completion Notes & Result</label>
                                                        <textarea name="completionNotes" class="form-control" rows="3" placeholder="Summary of call/meeting, agreed next steps..."></textarea>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Mark as Done</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start border-0 shadow">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i> Confirm Follow-up Removal</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to remove follow-up <strong>@f.Subject</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-check fs-1 d-block mb-2 text-secondary"></i>
                                No follow-ups found matching your filter selection.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-dateFilter="@Model.DateFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-dateFilter="@Model.DateFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-dateFilter="@Model.DateFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
