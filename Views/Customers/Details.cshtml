@model AcxiomCRM.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer: " + Model.Customer.CustomerName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold text-dark mb-0">@Model.Customer.CustomerName</h2>
            <span class="badge bg-light text-secondary border font-monospace">@Model.Customer.CustomerCode</span>
            <span class="badge @(Model.Customer.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                @Model.Customer.Status
            </span>
        </div>
        <p class="text-muted small mb-0 mt-1">
            Created on @Model.Customer.CreatedDate.ToString("MMM dd, yyyy") &bull; Managed by <strong>@(Model.Customer.AssignedTo?.FullName ?? "Unassigned")</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Opportunities" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-briefcase me-1"></i> New Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-outline-secondary">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Details Card -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle me-2 text-primary"></i> Contact Profile</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Company</dt>
                    <dd class="col-sm-7 fw-semibold">@(string.IsNullOrEmpty(Model.Customer.CompanyName) ? "—" : Model.Customer.CompanyName)</dd>

                    <dt class="col-sm-5 text-muted small">Email</dt>
                    <dd class="col-sm-7">
                        <a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a>
                    </dd>

                    <dt class="col-sm-5 text-muted small">Phone</dt>
                    <dd class="col-sm-7">@Model.Customer.Phone</dd>

                    <dt class="col-sm-5 text-muted small">Address</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Customer.Address) ? "—" : Model.Customer.Address)</dd>

                    <dt class="col-sm-5 text-muted small">City / State</dt>
                    <dd class="col-sm-7">@(Model.Customer.City ?? "—") / @(Model.Customer.State ?? "—")</dd>

                    <dt class="col-sm-5 text-muted small">Owner</dt>
                    <dd class="col-sm-7">@(Model.Customer.AssignedTo?.FullName ?? "Unassigned")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Right Column: Tabs for Deals, FollowUps, Activities -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3">
                <ul class="nav nav-tabs card-header-tabs" id="customerTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab">
                            Opportunities (@Model.Opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0">
                <div class="tab-content" id="customerTabContent">
                    <!-- Tab 1: Opportunities -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        @if (Model.Opportunities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Deal Name</th>
                                            <th>Stage</th>
                                            <th>Probability</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Close Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in Model.Opportunities)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-dark text-decoration-none">
                                                        @o.OpportunityName
                                                    </a>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@o.Stage</span>
                                                </td>
                                                <td>@o.Probability%</td>
                                                <td class="text-end fw-bold">$@o.Amount.ToString("N0")</td>
                                                <td class="text-end text-muted small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted small">
                                No sales opportunities created for this customer yet.
                            </div>
                        }
                    </div>

                    <!-- Tab 2: FollowUps -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Type</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.FollowUps)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@f.Subject</td>
                                                <td><span class="badge bg-secondary-subtle text-secondary">@f.FollowUpType</span></td>
                                                <td class="small text-muted">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <span class="badge @(f.Status == "Completed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                        @f.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted small">
                                No follow-up activities recorded yet.
                            </div>
                        }
                    </div>

                    <!-- Tab 3: Activities -->
                    <div class="tab-pane fade" id="activities" role="tabpanel">
                        @if (Model.Activities.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var a in Model.Activities)
                                {
                                    <div class="list-group-item p-3 border-0 border-bottom">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-semibold text-dark">@a.Subject</span>
                                            <span class="badge bg-info-subtle text-info border">@a.ActivityType</span>
                                        </div>
                                        <p class="text-muted small mb-1 mt-1">@a.Description</p>
                                        <div class="text-muted small">
                                            <i class="bi bi-clock me-1"></i> @a.ActivityDate.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted small">
                                No logged interactions recorded.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
