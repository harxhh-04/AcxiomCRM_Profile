@model IEnumerable<AcxiomCRM.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">User & Role Management</h2>
        <p class="text-muted small mb-0">System administrator controls for staff accounts, security lockouts, and permissions</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i> New System User
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Staff Member</th>
                        <th>Role</th>
                        <th>Account Status</th>
                        <th>Lockout Status</th>
                        <th>Created</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@user.FullName</div>
                                <span class="text-muted small">@user.Email</span>
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Administrator</span>
                                }
                                else if (user.Role == "Manager")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Sales Executive</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(user.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger text-white">LOCKED OUT</span>
                                    <span class="small text-muted d-block">Failed attempts: @user.FailedLoginCount</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Normal</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@user.CreatedDate.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit Role & Details">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="@(user.IsActive ? "Deactivate User" : "Activate User")">
                                            <i class="bi @(user.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            @(user.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                                <i class="bi bi-unlock"></i> Unlock
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </button>
                                </div>

                                <!-- Reset Password Modal -->
                                <div class="modal fade" id="resetModal-@user.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start border-0 shadow">
                                            <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title"><i class="bi bi-key-fill me-2 text-warning"></i> Reset Password for @user.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-3">Set a new temporary password for <strong>@user.Email</strong>. Password must meet complexity policy (min 8 chars, uppercase, lowercase, digit, symbol).</p>
                                                    <label class="form-label">New Password</label>
                                                    <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required minlength="8" />
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning">Reset Password</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
