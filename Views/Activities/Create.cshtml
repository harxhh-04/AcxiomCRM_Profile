@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Log Activity</h2>
                <p class="text-muted small mb-0">Record a customer phone call, meeting note, or completed task</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Activities
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ActivityType" class="form-label">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">In-Person / Virtual Meeting</option>
                                <option value="Email">Email Communication</option>
                                <option value="Task">Action Item / Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ActivityDate" class="form-label">Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label">Subject / Title <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Introductory scoping discussion" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="CustomerId" class="form-label">Related Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="LeadId" class="form-label">Related Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="OpportunityId" class="form-label">Related Opportunity</label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="AssignedToId" class="form-label">Logged By</label>
                            <select asp-for="AssignedToId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">-- Assign To Team Member --</option>
                            </select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Discussion Notes & Details</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes, client feedback, action items..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Save Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
